<mvc:View controllerName="project1.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    
    <VBox class="sapUiSmallMargin">
        <Button 
            text="Back"
            press="onBackPress"
            icon="sap-icon://nav-back"
            type="Transparent"
            class="sapUiSmallMarginTop" />
        
        <Button 
            text="Edit"
            press="onEditPress"
            visible="true"
            type="Emphasized"
            class="sapUiSmallMarginTop" />
        
        <Panel headerText="{i18n>materialDetails}" class="sapUiSmallMarginTop" expandable="false">
            <HBox>
                <Avatar class="sapUiSmallMarginEnd" initials="IS" />
                
                <VBox class="sapUiMediumMarginEnd">
                    <!-- Nazwa -->
                    <Text text="Nazwa: " />
                    <Input value="{materialModel>/Name}" editable="{=${editModel>/editMode} }"/>

                    <!-- Nazwisko -->
                    <Text text="Typ: " />
                    <Input value="{materialModel>/Type}" editable="{=${editModel>/editMode} }"/>

                    <!-- Stanowisko -->
                    <Text text="Waga: " />
                    <Input value="{materialModel>/Weight}" editable="{=${editModel>/editMode} }"/>
                </VBox>
                
                <!-- <VBox> -->
                    <!-- Email -->
                    <!-- <Text text="Email: " /> -->
                    <!-- <Input value="{materialModel>/Email}" type="Email" editable="{=${editModel>/editMode} }"/> -->

                    <!-- Numer telefonu -->
                    <!-- <Text text="Numer telefonu: " /> -->
                    <!-- <Input value="{materialModel>/Phone}" type="Tel" editable="{=${editModel>/editMode} }"/> -->
                <!-- </VBox> -->
            </HBox>
        </Panel>

        <Panel headerText="Opis materiału" class="sapUiSmallMarginTop" expandable="false">
            <Input value="{materialModel>/Description}" editable="{=${editModel>/editMode} }"/>
        </Panel>

        <!-- Przycisk Save oraz Cancel w trybie edycji -->
        <HBox visible="{${editModel>/editMode}}">
            <Button text="Save" press="onSavePress"/>
            <Button text="Cancel" press="onCancelPress"/>
        </HBox>
    </VBox>
    
</mvc:View>

<mvc:View controllerName="project1.controller.View1"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:table="sap.ui.table"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="page" title="{i18n>title}">
        <VBox>
            <fb:FilterBar id="filterbar" persistencyKey="materialFilterKey" useToolbar="false" filterChange="onFilterChange">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem name="Name" label="Nazwa" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idNameInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="Type" label="Typ" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idTypeInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="Weight" label="Waga" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idWeightInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
            <Table id="table" items="{path:'Materials>/Materials', sorter: {path: 'Name'}}" mode="SingleSelectLeft"  itemPress="onMaterialPress" selectionChange="onItemSelected">
                <headerToolbar>
                    <OverflowToolbar id="otbSubheader">
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://add" text="AddMaterial" tooltip="AddMaterial" press="onAddMaterial" />
                        <Button id="removeMaterialBtn" icon="sap-icon://delete" text="RemoveMaterial" tooltip="RemoveMaterial" press="onDeleteMaterial" enabled="false" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="{i18n>nameColumnTxt}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>typeColumnTxt}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>weightColumnTxt}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <Text text="{Materials>Name}" />
                            <Text text="{Materials>Type}" />
                            <Text text="{Materials>Weight}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>

<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:smartForm="sap.ui.comp.smartform" xmlns:smartField="sap.ui.comp.smartfield">
    <Dialog title="Add Material" class="sapUiResponsivePadding" contentWidth="25rem">
        <content>
            <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">
                <Label text="Nazwa" required="true" />
                <Input id="NameInput" placeholder="Nazwa"  />

                <Label text="Typ" required="true" />
                <Input id="TypeInput"/>

                <Label text="Waga" required="true"/>
                <Input id="WeightInput"/>

                <Label text="Opis" required="true"/>
                <Input id="DescriptionInput"/>

                <!-- <Label text="Email" type="Email" />
                <Input id="emailInput" liveChange="onInputLiveChange"/>

                <Label text="Phone" />
                <Input id="phoneInput" placeholder="123-456-789" liveChange="onInputLiveChange" /> -->
            </VBox>
        </content>
        <buttons>
            <Button text="Save" type="Emphasized" press="onSaveMaterial"/>
            <Button text="Cancel" press="onCancelMaterial"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>